 <Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="ClientApp\**" />
    <Content Remove="ClientApp\**" />
    <EmbeddedResource Remove="ClientApp\**" />
    <None Remove="ClientApp\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\core\Slickflow.Data\Slickflow.Data.csproj" />
    <ProjectReference Include="..\core\Slickflow.Engine\Slickflow.Engine.csproj" />
<ProjectReference Include="..\core\Slickflow.Graph\Slickflow.Graph.csproj" />
    <ProjectReference Include="..\core\Slickflow.Module.External\Slickflow.Module.External.csproj" />
    <ProjectReference Include="..\core\Slickflow.Module.Form\Slickflow.Module.Form.csproj" />
    <ProjectReference Include="..\core\Slickflow.Module.Localize\Slickflow.Module.Localize.csproj" />
    <ProjectReference Include="..\core\Slickflow.Module.Resource\Slickflow.Module.Resource.csproj" />
    <ProjectReference Include="..\core\Slickflow.Module\Slickflow.Module.csproj" />
    <ProjectReference Include="..\core\Slickflow.WebUtility\Slickflow.WebUtility.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Configuration.ConfigurationManager">
      <HintPath>..\DLL\System.Configuration.ConfigurationManager.dll</HintPath>
    </Reference>
    <Reference Include="System.Data.SqlClient">
      <HintPath>..\DLL\System.Data.SqlClient.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Update="samples\bpmn\business\askforleave.bpmn">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="samples\bpmn\business\contract.bpmn">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="samples\bpmn\business\eorder.bpmn">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="samples\bpmn\business\officein.bpmn">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="samples\bpmn\business\reimbursement.bpmn">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="samples\bpmn\business\warehousing.bpmn">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="samples\bpmn\logic\andsplitmi.bpmn">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="samples\bpmn\logic\complex.bpmn">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="samples\bpmn\logic\gateway.bpmn">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="samples\bpmn\logic\multipleinstance.bpmn">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="samples\bpmn\logic\sequence.bpmn">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="samples\bpmn\logic\subprocess.bpmn">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Copy Slickflow.Module.External output to Plugins so the host can load it from there. -->
  <Target Name="CopyExternalPluginToPlugins" AfterTargets="Build">
    <PropertyGroup>
      <_ExternalProjectPath>$(MSBuildThisFileDirectory)..\core\Slickflow.Module.External\Slickflow.Module.External.csproj</_ExternalProjectPath>
    </PropertyGroup>
    <MSBuild Projects="$(_ExternalProjectPath)" Targets="GetTargetPath" Properties="Configuration=$(Configuration);Platform=$(Platform)">
      <Output TaskParameter="TargetOutputs" PropertyName="_ExternalTargetPath" />
    </MSBuild>
    <PropertyGroup>
      <_ExternalDir>$([System.IO.Path]::GetDirectoryName($(_ExternalTargetPath)))</_ExternalDir>
      <_ExternalName>$([System.IO.Path]::GetFileNameWithoutExtension($(_ExternalTargetPath)))</_ExternalName>
      <_ExternalPdb>$(_ExternalDir)\$(_ExternalName).pdb</_ExternalPdb>
    </PropertyGroup>
    <ItemGroup>
      <_PluginFiles Include="$(_ExternalTargetPath)" />
      <_PluginFiles Include="$(_ExternalPdb)" Condition="Exists('$(_ExternalPdb)')" />
    </ItemGroup>
    <MakeDir Directories="$(OutputPath)Plugins" />
    <Copy SourceFiles="@(_PluginFiles)" DestinationFolder="$(OutputPath)Plugins\" SkipUnchangedFiles="true" />
  </Target>

</Project>
